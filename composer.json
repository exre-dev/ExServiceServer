{
  "name": "workerman/webman",
  "type": "project",
  "keywords": [
    "high performance",
    "http service"
  ],
  "homepage": "https://www.workerman.net",
  "license": "MIT",
  "description": "High performance HTTP Service Framework.",
  "authors": [
    {
      "name": "walkor",
      "email": "walkor@workerman.net",
      "homepage": "https://www.workerman.net",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "walkor@workerman.net",
    "issues": "https://github.com/walkor/webman/issues",
    "forum": "https://wenda.workerman.net/",
    "wiki": "https://workerman.net/doc/webman",
    "source": "https://github.com/walkor/webman"
  },
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "tinywan/jwt": "2.0",
    "webman/database": "^2.1",
    "illuminate/pagination": "^13.36",
    "illuminate/events": "^13.36",
    "symfony/var-dumper": "^8.1",
    "webman/limiter": "^2.2",
    "webman/redis": "^2.1",
    "webman/console": "^2.2",
    "phpmailer/phpmailer": "^7.1",
    "vlucas/phpdotenv": "^5.7",
    "guzzlehttp/guzzle": "^8.2",
    "webman-tech/swagger": "5.1.3"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "api:generate": "@php scripts/openapi.php generate",
    "api:lint": "@php scripts/openapi.php lint",
    "api:check": "@php scripts/openapi.php check",
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [{
    "name": "packagist",
    "type": "composer",
    "url": "https://repo.packagist.org"
  }]
}
