# 复制为 .env 并填入实际值（.env 不入库）

# 独立 PHP 监听；全栈入口的临时回环监听仅在本次进程中生效。
# EXWEBSITE_DEV_LISTEN、EXWEBSITE_DEV_WEB_URL、EXWEBSITE_DEV_RUN_ID 为保留字段，不得写入 .env。
SERVER_HOST=0.0.0.0
SERVER_PORT=8787

# PostgreSQL 应用连接；Compose 宿主机端口同样读取 POSTGRES_PORT，默认 5432。
# 首次部署可在管理端 /install 填写；数据库需先手动创建，表结构由初始化流程导入。
# POSTGRES_USER / POSTGRES_PASSWORD 是业务账号及其密码；Docker 管理密码见 .env.docker.example。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=webman
POSTGRES_USER=webman
POSTGRES_PASSWORD='your-app-db-password'

# Redis（初始化页面可填写）；Compose 宿主机端口同样读取 REDIS_PORT，默认 6379。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# 初始化自动生成独立随机密钥；请随 .env 一起备份
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 用户侧 Website 公开地址，用于 OAuth 设备授权登录链接
USER_WEB_URL=http://127.0.0.1:8080

# SMTP 邮件
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_NICKNAME="EXRE 社区"

# TxAdmin 后台（自营白名单管理）
TXADMIN_USER=your-txadmin-user
TXADMIN_PASSWORD=your-txadmin-password

# QQ 机器人（自营）
BOT_ENABLE=false
BOT_APPID=
BOT_SECRET=
Owner_ID=
OwnerGroup_ID=
