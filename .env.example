# 复制为 .env 并填入实际值（.env 不入库）

# 本地测试 PostgreSQL（docker: webman-pgsql）
# 首次部署可在管理端 /install 填写；数据库需先手动创建，表结构由初始化流程导入。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=webman
PG_USER=webman
PG_PASSWORD=change-me

# Redis（初始化页面可填写）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# 初始化自动生成独立随机密钥；请随 .env 一起备份
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP 邮件
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_NICKNAME=EXRE 社区

# TxAdmin 后台（自营白名单管理）
TXADMIN_USER=your-txadmin-user
TXADMIN_PASSWORD=your-txadmin-password

# QQ 机器人（自营）
BOT_ENABLE=false
BOT_APPID=
BOT_SECRET=
Owner_ID=
OwnerGroup_ID=
