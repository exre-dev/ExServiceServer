# 复制为 .env 并填入实际值（.env 不入库）

# MySQL（预留，当前 default 为 pgsql）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# 本地测试 PostgreSQL（docker: webman-pgsql）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=webman
PG_USER=webman
PG_PASSWORD=change-me

# SMTP 邮件
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_NICKNAME=EXRE 社区

# TxAdmin 后台（自营白名单管理）
TXADMIN_USER=your-txadmin-user
TXADMIN_PASSWORD=your-txadmin-password

# QQ 机器人（自营）
BOT_ENABLE=false
BOT_APPID=
BOT_SECRET=
Owner_ID=
OwnerGroup_ID=
